# Développement : copier en .env.dev (ignoré par git) et compléter avec les valeurs
# du .env de votre installation (~/Motflix/.env sur macOS).
# Le panel tourne alors sur votre machine et joint les outils par leurs ports locaux.

PORT=8080
MOTFLIX_DATA_DIR=./data
MEDIA_PATH=/Users/<vous>/Motflix/data

# Docker Desktop sur macOS : socket de l'utilisateur (voir « docker context inspect »).
DOCKER_HOST=unix:///Users/<vous>/.docker/run/docker.sock

RADARR_URL=http://127.0.0.1:7878
SONARR_URL=http://127.0.0.1:8989
PROWLARR_URL=http://127.0.0.1:9696
LAZYLIBRARIAN_URL=http://127.0.0.1:5299
FLARESOLVERR_URL=http://127.0.0.1:8191
QBITTORRENT_URL=http://127.0.0.1:8090
AUDIOBOOKSHELF_URL=http://127.0.0.1:13378
PLEX_URL=http://127.0.0.1:32400

RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
LAZYLIBRARIAN_API_KEY=
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=

# Compte de test à utiliser pour activer les comptes sur une base de développement jetable :
#   utilisateur : dev
#   mot de passe : motflix-dev-123
